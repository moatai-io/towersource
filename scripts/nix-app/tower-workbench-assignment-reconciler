#!/usr/bin/env bash
set -euo pipefail

fail(){ printf 'tower-workbench-assignment-reconciler: %s\n' "$*" >&2; exit 1; }
app_root="${TOWER_APP_ROOT:-$(dirname "$(dirname "$(realpath "$0")")")}"; app_root="$(realpath "$app_root")"
entrypoint="$app_root/lib/tower/dist/backend/packages/backend/scripts/reconcile-primary-worker-assignment.js"
[[ -f "$entrypoint" ]] || fail "missing assignment reconciler entrypoint: $entrypoint"
export TOWER_ASSIGNMENT_WORKER_INSTALLER="${TOWER_ASSIGNMENT_WORKER_INSTALLER:-$app_root/bin/install-local-workbench-worker-units}"
exec node "$entrypoint"
