#!/usr/bin/env bash
set -euo pipefail

fail(){ printf 'install-workbench-assignment-reconciler-unit: %s\n' "$*" >&2; exit 1; }
app_root="${TOWER_APP_ROOT:-${1:-}}"
[[ -n "$app_root" ]] || fail 'TOWER_APP_ROOT or first argument is required'
app_root="$(realpath "$app_root")"
reconciler="$app_root/bin/tower-workbench-assignment-reconciler"
[[ -x "$reconciler" ]] || fail 'Assignment reconciler launcher is missing from Nix closure'
worker_id="${TOWER_ASSIGNMENT_PRIMARY_WORKER_ID:-tower-prod-local-01}"
config_file="${TOWER_ASSIGNMENT_WORKER_CONFIG:-$HOME/.config/tower-workers/$worker_id.json}"
identity_file="${TOWER_ASSIGNMENT_WORKER_IDENTITY:-$HOME/.config/tower-workers/$worker_id.identity.jwt}"
[[ -f "$config_file" && -f "$identity_file" ]] || fail 'Primary Worker config and identity are required'

unit_dir="$HOME/.config/systemd/user"
mkdir -p "$unit_dir"
cat >"$unit_dir/tower-workbench-assignment-reconciler.service" <<EOF
[Unit]
Description=Tower production Project Worker assignment reconciler
After=network-online.target tower-prod-workbench-worker.service

[Service]
Type=oneshot
WorkingDirectory=/home/enterpriseai/tower
EnvironmentFile=/home/enterpriseai/tower/.env
Environment=NODE_ENV=production
Environment=WORKSPACE_ROOT=/home/enterpriseai/workspace
Environment=TOWER_ASSIGNMENT_DEPLOYMENT_ID=production
Environment=TOWER_ASSIGNMENT_PRIMARY_WORKER_ID=$worker_id
Environment=TOWER_ASSIGNMENT_WORKER_CONFIG=$config_file
Environment=TOWER_ASSIGNMENT_WORKER_IDENTITY=$identity_file
Environment=TOWER_ASSIGNMENT_PRIMARY_MAX_RUNS=5
Environment=TOWER_ASSIGNMENT_ACTOR_USER_ID=1
ExecStart=$reconciler
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/enterpriseai/.config/tower-workers /home/enterpriseai/.config/systemd/user /home/enterpriseai/workspace/projects
EOF

cat >"$unit_dir/tower-workbench-assignment-reconciler.timer" <<EOF
[Unit]
Description=Run Tower Project Worker assignment reconciler

[Timer]
OnBootSec=30s
OnUnitActiveSec=30s
AccuracySec=5s
Persistent=true
Unit=tower-workbench-assignment-reconciler.service

[Install]
WantedBy=timers.target
EOF

systemctl --user daemon-reload
systemctl --user enable tower-workbench-assignment-reconciler.timer
printf '{"status":"installed","timer":"tower-workbench-assignment-reconciler.timer","started":false}\n'
