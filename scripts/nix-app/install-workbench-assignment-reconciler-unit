#!/usr/bin/env bash
set -euo pipefail

fail(){ printf 'install-workbench-assignment-reconciler-unit: %s\n' "$*" >&2; exit 1; }
app_root="${TOWER_APP_ROOT:-${1:-}}"
[[ -n "$app_root" ]] || fail 'TOWER_APP_ROOT or first argument is required'
app_root="$(realpath "$app_root")"
reconciler="$app_root/bin/tower-workbench-assignment-reconciler"
[[ -x "$reconciler" ]] || fail 'Assignment reconciler launcher is missing from Nix closure'

worker_id="${TOWER_PRIMARY_WORKER_ID:-}"
[[ -n "$worker_id" ]] || fail 'TOWER_PRIMARY_WORKER_ID is required'
[[ "$worker_id" =~ ^[a-zA-Z0-9_-]+$ ]] || fail 'invalid primary Worker id'
[[ -z "${TOWER_ASSIGNMENT_PRIMARY_WORKER_ID:-}" || "$TOWER_ASSIGNMENT_PRIMARY_WORKER_ID" == "$worker_id" ]] || fail 'PRIMARY_WORKER_CONFIGURATION_MISMATCH'
deployment_id="${TOWER_ASSIGNMENT_DEPLOYMENT_ID:-production}"
working_directory="${TOWER_ASSIGNMENT_WORKING_DIRECTORY:-$PWD}"
environment_file="${TOWER_ASSIGNMENT_ENVIRONMENT_FILE:-$working_directory/.env}"
workspace_root="${TOWER_ASSIGNMENT_WORKSPACE_ROOT:-${WORKSPACE_ROOT:-$HOME/workspace}}"
actor_user_id="${TOWER_ASSIGNMENT_ACTOR_USER_ID:-1}"
worker_max_runs="${TOWER_ASSIGNMENT_PRIMARY_MAX_RUNS:-20}"
worker_port="${TOWER_ASSIGNMENT_WORKER_PORT:-43325}"
service_manager="${TOWER_ASSIGNMENT_SERVICE_MANAGER:-user}"
auto_backfill="${TOWER_ASSIGNMENT_AUTO_BACKFILL:-false}"
config_file="${TOWER_ASSIGNMENT_WORKER_CONFIG:-$HOME/.config/tower-workers/$worker_id.json}"
identity_file="${TOWER_ASSIGNMENT_WORKER_IDENTITY:-$HOME/.config/tower-workers/$worker_id.identity.jwt}"

for path_value in "$working_directory" "$environment_file" "$workspace_root" "$config_file" "$identity_file"; do
  [[ "$path_value" = /* ]] || fail "all configured paths must be absolute: $path_value"
done
working_directory="$(realpath -e "$working_directory")"
workspace_root="$(realpath -e "$workspace_root")"
[[ -f "$environment_file" ]] || fail "Environment file is required: $environment_file"
[[ -f "$config_file" && -f "$identity_file" ]] || fail 'Primary Worker config and identity are required'
[[ "$actor_user_id" =~ ^[1-9][0-9]*$ ]] || fail 'TOWER_ASSIGNMENT_ACTOR_USER_ID must be a positive integer'
[[ "$worker_max_runs" =~ ^[1-9][0-9]*$ ]] || fail 'TOWER_ASSIGNMENT_PRIMARY_MAX_RUNS must be a positive integer'
[[ "$worker_port" =~ ^[1-9][0-9]*$ && "$worker_port" -le 65535 ]] || fail 'TOWER_ASSIGNMENT_WORKER_PORT must be a valid port'
[[ "$service_manager" == user || "$service_manager" == system ]] || fail 'TOWER_ASSIGNMENT_SERVICE_MANAGER must be user or system'
[[ "$auto_backfill" == true || "$auto_backfill" == false ]] || fail 'TOWER_ASSIGNMENT_AUTO_BACKFILL must be true or false'

if [[ "$service_manager" == system ]]; then
  [[ "${EUID:-$(id -u)}" -eq 0 ]] || fail 'system service manager requires root'
  unit_dir=/etc/systemd/system
  systemctl_prefix=(systemctl)
  config_parent="$(dirname "$config_file")"
else
  unit_dir="$HOME/.config/systemd/user"
  systemctl_prefix=(systemctl --user)
  config_parent="$HOME/.config/tower-workers"
fi
mkdir -p "$unit_dir"
cat >"$unit_dir/tower-workbench-assignment-reconciler.service" <<EOF
[Unit]
Description=Tower Project Worker assignment reconciler
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=$working_directory
EnvironmentFile=$environment_file
Environment=NODE_ENV=production
Environment=WORKSPACE_ROOT=$workspace_root
Environment=TOWER_ASSIGNMENT_DEPLOYMENT_ID=$deployment_id
# Primary Worker is read from EnvironmentFile, shared with the Backend.
Environment=TOWER_ASSIGNMENT_WORKER_CONFIG=$config_file
Environment=TOWER_ASSIGNMENT_WORKER_IDENTITY=$identity_file
Environment=TOWER_ASSIGNMENT_PRIMARY_MAX_RUNS=$worker_max_runs
Environment=TOWER_ASSIGNMENT_WORKER_PORT=$worker_port
Environment=TOWER_ASSIGNMENT_SERVICE_MANAGER=$service_manager
Environment=TOWER_ASSIGNMENT_AUTO_BACKFILL=$auto_backfill
Environment=TOWER_ASSIGNMENT_ACTOR_USER_ID=$actor_user_id
ExecStart=$reconciler
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=$config_parent $unit_dir $workspace_root/projects
EOF

cat >"$unit_dir/tower-workbench-assignment-reconciler.timer" <<EOF
[Unit]
Description=Run Tower Project Worker assignment reconciler

[Timer]
OnBootSec=30s
OnUnitActiveSec=30s
AccuracySec=5s
Persistent=true
Unit=tower-workbench-assignment-reconciler.service

[Install]
WantedBy=timers.target
EOF

"${systemctl_prefix[@]}" daemon-reload
"${systemctl_prefix[@]}" enable tower-workbench-assignment-reconciler.timer
printf '{"status":"installed","timer":"tower-workbench-assignment-reconciler.timer","started":false}\n'
