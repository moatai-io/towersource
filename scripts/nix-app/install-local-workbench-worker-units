#!/usr/bin/env bash
set -euo pipefail

fail(){ printf 'install-local-workbench-worker-units: %s\n' "$*" >&2; exit 1; }
app_root="${TOWER_APP_ROOT:-${1:-}}"
[[ -n "$app_root" ]] || fail 'TOWER_APP_ROOT or first argument is required'
app_root="$(realpath "$app_root")"
worker_bin="$app_root/bin/tower-workbench-worker"
heartbeat_bin="$app_root/bin/tower-workbench-worker-heartbeat"
[[ -x "$worker_bin" && -x "$heartbeat_bin" ]] || fail 'Worker launchers are missing from the Nix closure'

worker_id="${TOWER_LOCAL_WORKER_ID:-tower-prod-local-01}"
deployment_id="${TOWER_LOCAL_WORKER_DEPLOYMENT_ID:-production}"
authority_mode="${TOWER_LOCAL_WORKER_AUTHORITY_MODE:-project}"
base_url="${TOWER_LOCAL_WORKER_BASE_URL:-http://127.0.0.1:43125}"
control_plane_url="${TOWER_LOCAL_WORKER_CONTROL_PLANE_URL:-http://127.0.0.1:32364}"
config_file="${TOWER_LOCAL_WORKER_CONFIG_FILE:-$HOME/.config/tower-workers/$worker_id.json}"
env_file="${TOWER_LOCAL_WORKER_ENV_FILE:-$HOME/.config/tower-workers/$worker_id.env}"
identity_file="${TOWER_LOCAL_WORKER_IDENTITY_FILE:-$HOME/.config/tower-workers/$worker_id.identity.jwt}"
project_ids="${TOWER_LOCAL_WORKER_PROJECT_IDS:-}"
read_write_paths="${TOWER_LOCAL_WORKER_READ_WRITE_PATHS:-}"
worker_pool_cpu_quota="${TOWER_WORKER_POOL_CPU_QUOTA:-300%}"
worker_pool_memory_high="${TOWER_WORKER_POOL_MEMORY_HIGH:-6G}"
worker_pool_memory_max="${TOWER_WORKER_POOL_MEMORY_MAX:-8G}"
worker_pool_tasks_max="${TOWER_WORKER_POOL_TASKS_MAX:-2048}"
worker_memory_max="${TOWER_LOCAL_WORKER_MEMORY_MAX:-6G}"
worker_tasks_max="${TOWER_LOCAL_WORKER_TASKS_MAX:-1024}"
worker_max_runs="${TOWER_LOCAL_WORKER_MAX_RUNS:-20}"
[[ "$worker_max_runs" =~ ^[0-9]+$ && "$worker_max_runs" -ge 3 ]] || fail 'TOWER_LOCAL_WORKER_MAX_RUNS must be at least 3 capacity units'
[[ "$authority_mode" == "project" ]] || fail 'Worker authority must be project; Operator access uses the native Operator execution environment'
[[ -f "$config_file" ]] || fail "Worker config missing: $config_file"
[[ -f "$env_file" ]] || fail "Worker transport env missing: $env_file"
[[ -f "$identity_file" ]] || fail "Worker identity missing: $identity_file"
[[ -n "$project_ids" ]] || fail 'TOWER_LOCAL_WORKER_PROJECT_IDS is required'
[[ -n "$read_write_paths" ]] || fail 'TOWER_LOCAL_WORKER_READ_WRITE_PATHS is required'

worker_capabilities='job,service,shell'

unit_dir="$HOME/.config/systemd/user"
mkdir -p "$unit_dir"
if [[ "$worker_id" == "tower-prod-local-01" ]]; then
  unit_prefix="tower-prod-workbench-worker"
else
  unit_prefix="tower-prod-workbench-worker-${worker_id#tower-prod-local-}"
fi
worker_unit_name="$unit_prefix.service"
heartbeat_unit_name="$unit_prefix-heartbeat.service"
worker_unit="$unit_dir/$worker_unit_name"
heartbeat_unit="$unit_dir/$heartbeat_unit_name"
slice_unit="$unit_dir/tower-workers.slice"

cat >"$slice_unit" <<EOF
[Unit]
Description=Tower local Worker pool resource budget

[Slice]
CPUQuota=$worker_pool_cpu_quota
MemoryHigh=$worker_pool_memory_high
MemoryMax=$worker_pool_memory_max
TasksMax=$worker_pool_tasks_max
EOF

cat >"$worker_unit" <<EOF
[Unit]
Description=Tower production local Workbench Worker
After=network-online.target

[Service]
Type=simple
Slice=tower-workers.slice
MemoryMax=$worker_memory_max
TasksMax=$worker_tasks_max
Environment=TOWER_REMOTE_WORKER_CONFIG=$config_file
EnvironmentFile=$env_file
ExecStart=$worker_bin
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
EOF

cat >"$heartbeat_unit" <<EOF
[Unit]
Description=Tower production local Workbench Worker heartbeat
After=$worker_unit_name
Requires=$worker_unit_name

[Service]
Type=simple
Slice=tower-workers.slice
MemoryMax=256M
TasksMax=128
Environment=TOWER_LOCAL_WORKER_ID=$worker_id
Environment=TOWER_LOCAL_WORKER_DEPLOYMENT_ID=$deployment_id
Environment=TOWER_LOCAL_WORKER_BASE_URL=$base_url
Environment=TOWER_LOCAL_WORKER_CONTROL_PLANE_URL=$control_plane_url
Environment=TOWER_LOCAL_WORKER_PROJECT_IDS=$project_ids
Environment=TOWER_LOCAL_WORKER_CAPABILITIES=$worker_capabilities
Environment=TOWER_LOCAL_WORKER_MAX_RUNS=$worker_max_runs
Environment=TOWER_LOCAL_WORKER_IDENTITY_FILE=$identity_file
ExecStart=$heartbeat_bin
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
EOF

systemctl --user daemon-reload
systemctl --user enable "$worker_unit_name" "$heartbeat_unit_name"
printf '{"status":"installed","workerId":"%s","deploymentId":"%s","authorityMode":"%s","workerUnit":"%s","heartbeatUnit":"%s","slice":"tower-workers.slice","started":false}\n' "$worker_id" "$deployment_id" "$authority_mode" "$worker_unit_name" "$heartbeat_unit_name"
