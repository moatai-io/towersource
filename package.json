{
  "name": "tower",
  "version": "1.70.29",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/apply-pi-eventstream-patch.mjs",
    "predev": "fuser -k 32354/tcp 32355/tcp 2>/dev/null; pkill -f 'packages/backend/scripts/[v]oice-livekit-worker.ts' 2>/dev/null || true",
    "dev": "concurrently --kill-others-on-fail \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:voice\"",
    "dev:backend": "PORT=32355 HOST=0.0.0.0 GIT_AUTO_COMMIT=true TOWER_ROLE=full TOWER_AGENT_FIRST_ENABLED=true WORKSPACE_ROOT=$HOME/workspace DEFAULT_CWD=$HOME/workspace tsx watch --ignore './packages/backend/db/schema.ts' --ignore './packages/backend/db/migrations/*' --ignore './workspace/*' --ignore './docs/*' --ignore './data/*' packages/backend/index.ts",
    "dev:frontend": "vite --host 0.0.0.0 --port 32354",
    "dev:voice": "TOWER_VOICE_PROJECT_ID=7d84f926-1fcd-438d-94dc-a36048636bad tsx packages/backend/scripts/voice-livekit-worker.ts",
    "build": "vite build && tsc -p tsconfig.backend.json && cp -r packages/backend/db/migrations dist/backend/packages/backend/db/ && mkdir -p dist/runtime-packages/@tower && cp -r dist/backend/packages/shared dist/runtime-packages/@tower/shared && cp packages/shared/package.json dist/runtime-packages/@tower/shared/package.json",
    "start": "pm2 start ecosystem.config.cjs",
    "stop": "pm2 stop tower",
    "restart": "echo '⚠️  개발 중에는 npm run dev 를 사용하세요. restart는 production 전용 (DB 경로가 달라짐)' && npm run build && pm2 restart tower",
    "logs": "pm2 logs tower --lines 50",
    "preview": "vite preview",
    "test": "vitest run --maxWorkers=${VITEST_MAX_WORKERS:-100%}",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:credentials": "CREDENTIAL_VAULT_E2E=1 vitest run packages/backend/services/credential-vault/agent-credential-lifecycle.e2e.test.ts --no-file-parallelism",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit -p tsconfig.backend.json && tsc --noEmit -p tsconfig.frontend.json && node scripts/check-theme-color-contracts.mjs",
    "skills:materialize": "tsx packages/backend/scripts/materialize-managed-skills.ts",
    "tower": "tsx packages/backend/scripts/tower-cli.ts",
    "tower:server": "tsx packages/backend/scripts/tower-server-cli.ts",
    "provider:doctor": "tsx packages/backend/scripts/provider-doctor.ts",
    "publish:thumbnails": "tsx packages/backend/scripts/backfill-publish-thumbnails.ts",
    "smoke:ai-service-public-channel": "TOWER_ROLE=full WORKSPACE_ROOT=${WORKSPACE_ROOT:-$HOME/workspace} tsx packages/backend/scripts/ai-service-public-channel-smoke.ts",
    "lint:dialogs": "node scripts/check-no-native-dialogs.mjs",
    "lint:pi-tools": "node scripts/check-pi-tool-context-contracts.mjs",
    "lint:theme-colors": "node scripts/check-theme-color-contracts.mjs",
    "lint:migration-locks": "node scripts/check-migration-lock-risks.mjs",
    "audit:claude-legacy": "node scripts/audit-claude-legacy-refs.mjs",
    "audit:frontend-copy": "node scripts/frontend-copy-inventory.mjs",
    "preflight": "npm run typecheck && npm run lint:dialogs && npm run lint:pi-tools && npm run lint:migration-locks && npm test",
    "release": "commit-and-tag-version",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "release:dry": "commit-and-tag-version --dry-run"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/archiver": "^7.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "commit-and-tag-version": "^12.7.1",
    "concurrently": "^10.0.3",
    "jsdom": "^28.1.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.204",
    "@anthropic-ai/sdk": "0.110.0",
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@mendable/firecrawl-js": "^4.30.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@sinclair/typebox": "^0.34.49",
    "archiver": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "chokidar": "^4.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "esbuild": "0.25.12",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "force-graph": "^1.51.4",
    "form-data": "4.0.6",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "proper-lockfile": "^4.1.2",
    "uuid": "14.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "vite": "$vite",
    "zod": "4.4.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@hono/node-server": "1.19.13",
    "hono": "4.12.28",
    "esbuild": "0.25.12",
    "fast-uri": "3.1.3",
    "form-data": "4.0.6",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "tmp": "0.2.7"
  }
}
