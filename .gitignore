# Prevent accidental commits of workspace/ repo when tasks run in subfolders
/workspace/

# Session-local work notes, scratch scripts, QA helpers, and job-board dogfood records.
# Durable decisions/docs should be promoted to workspace/decisions/ or docs/ before committing.
/work/

# Local scratch space. Never commit temporary patches, tokens, or runtime handoff files.
/.tmp/
/tmp/

# Local dev process bookkeeping. Runtime logs are already ignored by *.log.
/logs/*.pid

# Tower-generated Runtime Box state (Workbench tools, service logs, pids, caches)
.runtime-box/
**/.runtime-box/

# Tower-generated managed skill materialization outputs
/.tower/
**/.tower/skills/
**/.tower/skills/**

# Python bytecode cache
__pycache__/
*.pyc

# Playwright E2E artifacts
/playwright-report/
/test-results/
/blob-report/
