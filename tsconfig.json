{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["packages/frontend/src/*"],
      "@tower/shared": ["packages/shared/index.ts"]
    }
  },
  "include": ["packages", "vite-env.d.ts"],
  "exclude": [
    "packages/backend/scripts/migrate-sqlite-to-pg.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**"
  ],
  "references": [{ "path": "./tsconfig.backend.json" }]
}
