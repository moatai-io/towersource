# ─────────────────────────────────────────────
# Tower — Environment Variables
# ─────────────────────────────────────────────
# Copy this file:  cp .env.example .env
# Then edit values below.
# ─────────────────────────────────────────────

# ── Server ──
PORT=32354
HOST=0.0.0.0

# ── Uploads ──
# Max upload size per file, in MB. Default 200.
# IMPORTANT: keep in sync with nginx `client_max_body_size` for the domain
# that proxies to this server (tower.tower.example.com / desk-dev.tower.example.com etc.).
# See workspace/decisions/2026-04-24-file-upload-limits-and-inline-detection.md
# UPLOAD_MAX_SIZE=200

# Resumable folder uploads. Defaults: 8MiB chunks, 4GiB project upload quota,
# 72h session TTL. Uploaded files are project materials and are never auto-committed.
# RESUMABLE_UPLOAD_CHUNK_SIZE_MB=8
# PROJECT_UPLOAD_QUOTA_MB=4096
# RESUMABLE_UPLOAD_SESSION_TTL_HOURS=72

# ── Workspace ──
# Root directory that users can browse via file tree
WORKSPACE_ROOT=$HOME/workspace
# Default working directory for new Claude sessions
DEFAULT_CWD=$HOME/workspace
# Default language for AI responses (ISO 639-1 code: ko | en | ja | zh | ...).
# Used when a user has no explicit language preference. 3-layer resolution:
#   session.language  >  user.language  >  WORKSPACE_LANGUAGE  >  'ko'
# See workspace/decisions/2026-04-23-language-propagation-design.md
WORKSPACE_LANGUAGE=ko

# ── Customer Branding ──
# Optional VM-local image path for the post-login chat/rooms background.
# Keep this in each self-hosted server's .env so branding survives Tower code deploys.
# TOWER_APP_BACKGROUND_IMAGE=/home/tower/workspace/brand/logo/png-hires/oku_horizontal_green_dark_trans_1500.png

# ── Auth ──
# IMPORTANT: Change this to a random secret in production!
#
# ⚠️  JWT_SECRET is also the password encryption key.
#    User passwords are stored AES-256-GCM-encrypted with a key derived from
#    JWT_SECRET (SHA-256). Rotating this value invalidates EVERY stored
#    password — they become unrecoverable ciphertext, and every user gets
#    locked out until an admin resets their password.
#
#    Operational rule: `.env` and the Postgres dump are a paired backup.
#    Restore them together, never one without the other.
#
#    See: workspace/decisions/2026-04-28-demo-server-claude-mode-swap.md
JWT_SECRET=change-me-to-a-random-secret
# Set to 'true' to disable authentication (local dev only)
# NO_AUTH=true

# ── Claude ──
# Enable Claude engine (default: true). Set to false for Pi-only deployments
# (e.g. customers without an Anthropic account). The UI and API then hide
# Claude-specific controls and reject Claude sessions/quick-replies.
# CLAUDE_ENABLED=true
# Anthropic API key (alternative to 'claude login')
# Get yours at: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# Permission mode: 'default' | 'acceptEdits' | 'bypassPermissions'
PERMISSION_MODE=bypassPermissions
# Max concurrent Claude sessions
MAX_CONCURRENT_SESSIONS=10
# Path to Claude CLI (auto-detected if not set)
# CLAUDE_PATH=/usr/local/bin/claude

# ── Pi Agent (Multi-Engine) ──
# Enable Pi Agent engine alongside (or instead of) Claude Code
# PI_ENABLED=true
# Default engine for new sessions: 'claude' or 'pi'
# DEFAULT_ENGINE=claude
#
# Pi picks its upstream provider per model (see packages/backend/models.json).
# Configure the providers you actually use — you don't need all of them.
#
# ‣ Azure OpenAI (provider: 'azure-openai-responses')
#   AZURE_OPENAI_API_KEY=...
#   AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai
#   AZURE_OPENAI_API_VERSION=2025-03-01-preview
#   # Map model IDs (from packages/backend/models.json) to Azure deployment names, comma-separated:
#   AZURE_OPENAI_DEPLOYMENT_NAME_MAP=gpt-5.4=gpt-54-tower,gpt-5.4-mini=gpt-54-mini-tower
#
# ‣ OpenRouter (default provider) — pay-per-token, many models
#   Get yours at: https://openrouter.ai/keys
#   OPENROUTER_API_KEY=sk-or-v1-...
#   # Optional OpenAI-compatible base URL override:
#   # OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# ‣ OpenAI-compatible Responses endpoint
#   Works with OpenAI and gateways that implement POST /v1/responses.
#   OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1
#   OPENAI_RESPONSES_API_KEY=sk-...
#
# ‣ OpenAI direct (legacy provider namespace)
#   OPENAI_API_KEY may be used by non-Pi features such as image generation.
#   To prevent accidental expensive Pi fallback to OpenAI direct models, Tower
#   does NOT inject OPENAI_API_KEY into Pi by default.
#   Opt in only when you intentionally add provider:'openai' models to models.json:
#   PI_ALLOW_OPENAI_DIRECT=1
#   OPENAI_API_KEY=sk-...
#
# After configuring a provider, verify model/default readiness:
#   npm run provider:doctor

# ── Local LLM (OpenAI-compatible API) ──
# Enable local LLM engine (llama.cpp, vLLM, Ollama, etc.)
# LOCAL_LLM_ENABLED=true
# Base URL for the OpenAI-compatible API endpoint
# LOCAL_LLM_BASE_URL=http://localhost:8080
# API key (if required by the server, leave empty if not needed)
# LOCAL_LLM_API_KEY=
# Default model to use (must match a model ID from packages/backend/models.json)
# LOCAL_LLM_DEFAULT_MODEL=local-default

# ── Sandbox (Linux only) ──
# Isolate Claude CLI in a bwrap sandbox (filesystem + PID isolation)
# Requires: apt install bubblewrap
# SANDBOX_ENABLED=true

# ── Database ──
# Tower runs on PostgreSQL. SQLite was retired in the 3/2026 migration —
# `DB_PATH` is no longer read. You must set `DATABASE_URL` for the server
# to boot; chat rooms, sessions, users, and search all live in Postgres.
#
# Required extensions (create once as superuser):
#   CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
#   CREATE EXTENSION IF NOT EXISTS pg_trgm;
#
# Standard TCP form:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
#
# Peer-auth over the Unix socket (no password in the URL — the OS user
# must match the Postgres role). Note: node-postgres doesn't auto-detect
# the socket, so pass the directory as `host=` in the query string:
#   DATABASE_URL=postgresql://admin@localhost/tower?host=/var/run/postgresql
DATABASE_URL=postgresql://tower:tower@localhost:5432/tower

# ── Git ──
# Auto-commit AI/code edit flows. Default is off; uploaded files are never auto-committed.
# Set to true only when this VM intentionally wants git audit commits for AI edits.
# GIT_AUTO_COMMIT=true
# Generate commit messages via Haiku (Korean one-line summary). Set to false
# to skip the AI call and use the legacy "Claude task completed" message.
# GIT_AUTO_COMMIT_AI_MESSAGE=true
# Timeout for the Haiku call (ms). Default 60000. The call happens after
# the user's reply is already streamed, so it doesn't block UX — but if the
# SDK cold-starts past this window, we silently fall back. Was 8000 originally,
# which timed out ~100% of the time in production.
# GIT_AUTO_COMMIT_AI_TIMEOUT_MS=60000

# ── Google OAuth ──
# Gmail, Calendar, Drive integration (Settings → Google 연결)
# Register app at: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-domain.example.com/api/auth/google/callback

# ── Kakao OAuth ──
# KakaoTalk messaging integration (Settings → KakaoTalk 연결)
# Register app at: https://developers.kakao.com
# KAKAO_REST_KEY=
# KAKAO_CLIENT_SECRET=
# KAKAO_REDIRECT_URI=https://your-domain.example.com/api/auth/kakao/callback

# ── Outbound messaging kill switch ──
# Tower channel is the AI ↔ user funnel after Phase 1~2 (2026-05-04). External
# messengers (Kakao/Telegram) are PAUSED by default — sendAny() no-ops.
# Set to 'true' to re-enable automatic external push (task done, heartbeat,
# proactive). Explicit user-clicked tests (e.g. "Test Connection") are not
# gated and work regardless.
# See: workspace/decisions/2026-05-05-outbound-messaging-paused.md
# OUTBOUND_MESSAGING_ENABLED=false

# ── Publishing & Deployment ──
# Tower deployment profile determines publishing behavior and operator surfaces:
#   'standalone' — Independent self-host (recommended default). No external operator dependency.
#   'managed'    — Self-hosted node connected to your organization's configured Publish Gateway.
#   'full'       — Organization control plane. Enables operator surfaces and can host a Publish Gateway.
# Deployment ownership boundary:
#   - standalone: this server owns its providers, publishing credentials, upgrades, and operations.
#   - managed: the node operator explicitly configures an organization gateway; it is never implicit.
#   - full: the organization operates the control plane and any multi-instance registry.
# Keep this explicit. Some low-level policies safely fall back to standalone when
# omitted, while product feature gates deliberately require an explicit role.
TOWER_ROLE=standalone

# Optional full-profile Fleet registry. Leave unset for standalone/managed self-hosts.
# TOWER_FLEET_REGISTRY_PATH=/etc/tower/fleet-registry.md

# Optional GitHub issue integration. No repository is selected by default.
# Set an organization-owned repository before enabling the issue skill.
# GITHUB_ISSUE_REPO=example-org/tower-issues

# Agent-first product surface. On standalone servers this must be explicitly true
# to expose the first-level Agent rail, AI Team home, Primary Agent profiles, and
# guarded Agent creation APIs. Set false only for emergency rollback; existing
# Agent Projects and data are retained but hidden from Agent-first surfaces.
TOWER_AGENT_FIRST_ENABLED=true

# Materialize the configured public skill seed into eligible Project Runtimes.
# Keep the actual public skill list constrained by OSS export allow/deny policy.
RUNTIME_BOX_MATERIALIZE_SKILLS=true

# Stable ID of the host-local production Project Worker used for Worker-first
# assignment of new Projects. Installer/bootstrap/Doctor must use the same value.
TOWER_PRIMARY_WORKER_ID=tower-oss-local-01

# Default UI language for users who have not selected one yet: en (OSS default) or ko.
# TOWER_DEFAULT_LANGUAGE=ko
# Publish Gateway — only needed for managed mode
# PUBLISH_GATEWAY_URL=https://gateway.tower.example.com/api/gateway/publish
# PUBLISH_API_KEY=<gateway-issued-key>
# Cloudflare Pages — for full/standalone modes
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Azure Container Apps — for full/standalone modes
# AZURE_RESOURCE_GROUP=tower-apps
# AZURE_CONTAINER_ENV=tower-apps-env
# AZURE_REGISTRY=towerexample.azurecr.io
# AZURE_REGISTRY_NAME=towerexample

# ── Public URL ──
# Canonical URL used for generating share links.
# Set this to your actual domain so share links always point to the right place.
# Without this, links use window.location.origin (can be wrong if accessed via tunnel/localhost)
# PUBLIC_URL=https://your-domain.example.com

# ── Frontend dev-only host gates ──
# Comma-separated extra hostnames that may access dev-only frontend surfaces such as /voice-lab
# in a production-built bundle. Generic desk-dev.* hosts and app.localhost are allowed by default.
# Keep real internal domains in deployment env, not source.
# VITE_TOWER_DEV_HOSTS=voice-lab-dev.example.com

# ── File preview AI inline edit ──
# Default OFF. When true, users can drag-select text in Markdown/HTML file
# previews and ask AI to rewrite that selected fragment. The module remains in
# code, but the frontend UI and /api/files/inline-edit route stay hidden unless
# this is explicitly enabled for dogfooding.
# INLINE_EDIT_ENABLED=true

# ── File preview direct edit ──
# Source-backed cursor editing in Markdown/HTML preview surfaces. Default ON
# across all VM roles. Set to false only for emergency rollback.
# PREVIEW_DIRECT_EDIT_ENABLED=false

# ── AI-native PM (alpha, Full profile only) ──
# When true, exposes /api/ideas/* routes and the frontend "Ideas" tab.
# Distiller still runs only on manual trigger via scripts/distill-once.ts;
# auto-trigger (Stop hook integration) is a separate Phase 1.5 task.
# Leave OFF on managed/standalone deployments — alpha quality is not for
# customer exposure. See workspace/decisions/2026-04-24-ai-native-pm-*.md
# AI_PM_ENABLED=true

# ── Fleet (self-hosted server management) ──
# POST /api/admin/fleet/:customer/exec — disabled by default.
# The substring blocklist in remoteExec is trivially bypassable, and an
# admin JWT here yields instant self-hosted-server takeover. Set to 'true' ONLY
# for emergency ops, then immediately revert. Will be replaced by a
# command-catalog API (TWR-03 medium-term).
# See workspace/decisions/2026-04-28-twr-03-fleet-exec-disable.md
# FLEET_EXEC_ENABLED=true

# ── Execution Sandbox (Phase 1, optional, Full only) ──────────────────
# AI 가 짧은 코드를 격리 실행할 때 사용하는 별도 VM. Tower 본체 인스턴스마다
# 자기 전용 execution VM 을 1:1 로 가짐. 비우면 sandbox 기능 자체 비활성.
# 결정: workspace/decisions/2026-04-24-execution-sandbox-scope.md (D8)
# 계획: tower/docs/plans/2026-04-26-execution-sandbox-phase1.md (1a)
ENABLE_SANDBOX=false
EXECUTION_VM_HOST=                    # IP 또는 ssh config alias (예: 20.194.63.1 또는 exec-tower)
EXECUTION_VM_USER=toweradmin
EXECUTION_VM_KEY_PATH=                # 비우면 ssh-agent / 기본 키 사용
EXECUTION_VM_SSH_TIMEOUT=15           # 초
# 멀티유저 안전망
SANDBOX_GLOBAL_CONCURRENCY_CAP=8                            # 전체 동시 실행 cap (B1ms 권장)
SANDBOX_MEMBER_WORKSPACE_PREFIXES=sandbox-tools/,projects/  # member 이하 Mode B mount 허용 prefix
# Secret store (Q12) — Sandbox 가 외부 API 키 등 secret 을 컨테이너 ENV 로 안전 주입.
# 생성: openssl rand -hex 32 (64 hex chars = 32 bytes 마스터 키)
# 비우면 secrets 기능 비활성 (일반 sandbox 실행은 영향 없음).
# ⚠️ 이 키 분실 시 모든 저장 secret 영구 손실 — 안전한 곳 백업 필수.
SECRET_STORE_MASTER_KEY=

# ── Project Runtime Box ─────────────────────────────────────────────────────
# Per-project persistent container (Terminal + IDE + Process panel 경험).
# 결정: workspace/decisions/2026-06-02-project-runtime-box-product-framing.md
#
# ENABLE_PROJECT_RUNTIME_BOX=true     → Pi session 에 project_shell / service_* 도구 마운트.
#                                       기본값 false (opt-in) — 운영자가 명시 설정 필요.
ENABLE_PROJECT_RUNTIME_BOX=false
#
# RUNTIME_BOX_IMAGE                   → 사용할 Docker 이미지명. 없으면 RuntimeBoxError.
#                                       빌드: docker build -t tower-runtime-box:node22-python313 packages/backend/sandbox-images/runtime-box-node22-python313/
RUNTIME_BOX_IMAGE=tower-runtime-box:node22-python313
#
# RUNTIME_BOX_DOCKER_BIN              → Docker 바이너리 경로. PATH 에 없으면 절대경로 지정.
RUNTIME_BOX_DOCKER_BIN=docker
#
# RUNTIME_BOX_EXCLUDED_PROJECTS       → Runtime Box 에서 제외할 project ID/name (콤마 구분).
#                                       Tower 코어, admin 전용 프로젝트 차단 용도.
#                                       예: tower,_team,admin
RUNTIME_BOX_EXCLUDED_PROJECTS=tower,_team
#
# RUNTIME_BOX_DEFAULT_MEMORY_MB       → Box 기본 메모리 제한 (기본 3072 = 3GB).
RUNTIME_BOX_DEFAULT_MEMORY_MB=3072
# RUNTIME_BOX_MAX_MEMORY_MB           → Box 최대 메모리 hard cap (기본 3072 = 3GB).
RUNTIME_BOX_MAX_MEMORY_MB=3072
# RUNTIME_BOX_MAX_RUNNING             → 서버 전체 동시 running box 수 상한 (기본 8).
RUNTIME_BOX_MAX_RUNNING=8
# RUNTIME_BOX_MAX_RUNNING_PER_USER    → 사용자당 running box 수 상한 (기본 5).
RUNTIME_BOX_MAX_RUNNING_PER_USER=5

# Optional explicit per-VM model registry path.
# Default resolution: data/models.json when present, otherwise packaged fallback.
# TOWER_MODELS_PATH=/etc/tower/models.json
